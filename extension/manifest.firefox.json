{
  "manifest_version": 2,
  "name": "Seamless Download Manager",
  "short_name": "Seamless",
  "version": "0.1.0",
  "description": "Sends downloads from your browser to Seamless Download Manager.",
  "browser_specific_settings": { "gecko": { "id": "sdm@seamless.local", "strict_min_version": "115.0" } },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "browser_action": {
    "default_title": "Seamless Download Manager",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "background": { "page": "background.html", "persistent": true },
  "permissions": [
    "webRequest", "webRequestBlocking", "cookies", "storage", "tabs", "downloads", "nativeMessaging", "contextMenus",
    "http://*/*", "https://*/*"
  ],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
