export global Mocha {
    out property <color> base: #1e1e2e;
    out property <color> mantle: #181825;
    out property <color> crust: #11111b;
    out property <color> surface0: #313244;
    out property <color> surface1: #45475a;
    out property <color> surface2: #585b70;
    out property <color> overlay0: #6c7086;
    out property <color> overlay1: #7f849c;
    out property <color> text: #cdd6f4;
    out property <color> subtext1: #bac2de;
    out property <color> subtext0: #a6adc8;
    out property <color> blue: #89b4fa;
    out property <color> mauve: #cba6f7;
    out property <color> green: #a6e3a1;
    out property <color> peach: #fab387;
    out property <color> red: #f38ba8;
    out property <color> yellow: #f9e2af;

    out property <color> edge: #45475a.with-alpha(0.9);
    out property <brush> hover-edge: @linear-gradient(45deg, #89b4fa 0%, #cba6f7 100%);
    out property <color> dock: #181825.with-alpha(0.32);
    out property <color> card: #181825.with-alpha(0.42);
    out property <color> popup: #1e1e2e;

    out property <length> r-card: 14px;
    out property <length> r-popup: 10px;
    out property <length> r-box: 8px;
    out property <duration> fast: 150ms;

    out property <length> fs-small: 12px;
    out property <length> fs-body: 13px;
    out property <length> fs-row: 14px;
    out property <length> fs-title: 18px;
}

